# Generation backend
CHATBOT_BACKEND=anthropic
ANTHROPIC_API_KEY=<your-anthropic-api-key>
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_TIMEOUT_SECONDS=60

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=<your-langsmith-api-key>
LANGSMITH_PROJECT=korean-chatbot-rag-dev

# Optional local LangFeather tracing
LANGFEATHER_ENABLED=false
LANGFEATHER_ENDPOINT=http://127.0.0.1:4319

# Future Finlife API integration
FINLIFE_API_KEY=<your-finlife-api-key>
